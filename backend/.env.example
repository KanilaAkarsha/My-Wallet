# ---- Server ----
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
DEFAULT_CURRENCY=LKR
DEFAULT_TIMEZONE=Asia/Colombo

# ---- MongoDB (transactions require a replica set; Atlas or `mongod --replSet rs0`) ----
MONGODB_URI=mongodb://localhost:27017/mywallet?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Security (generate each with: openssl rand -hex 32) ----
SESSION_SECRET=replace-me-with-64-hex-chars
CSRF_SECRET=replace-me-with-64-hex-chars
# 32-byte key, hex. Used for app-level field encryption (2FA secrets). Rotate via KEY_ID.
FIELD_ENCRYPTION_KEY=replace-me-with-64-hex-chars
FIELD_ENCRYPTION_KEY_ID=k1

# ---- Email (optional; verification/reset emails are logged-not-sent if unset) ----
SMTP_URL=  # e.g. smtps://user:pass@smtp.example.com:465 (empty = dev logs links, prod sends nothing)
EMAIL_FROM=MyWallet <no-reply@mywallet.example>

# ---- Payments (optional; billing endpoints return 'not configured' if unset) ----
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Google sign-in (optional; the button is hidden and /auth/google returns 501 if unset) ----
# Create at https://console.cloud.google.com/apis/credentials  (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Must match an "Authorized redirect URI" exactly. Default: APP_ORIGIN + /api/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
